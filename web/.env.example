# Para runtime Supabase + WhatsApp real, use supabase no .env.local ignorado.
DATABASE_PROVIDER=sqlite
CHATPRO_DATA_DIR=.chatpro-data
CHATPRO_DATABASE_PATH=.chatpro-data/backend.sqlite
WHATSAPP_CONNECTION_ENABLED=false
WHATSAPP_DEMO_MODE=false
WHATSAPP_PROVIDER=baileys
# Runtime real (npm run dev:whatsapp):
# DATABASE_PROVIDER=supabase
# WHATSAPP_DEMO_MODE=false
# WHATSAPP_CONNECTION_ENABLED=true
WHATSAPP_MAX_RECONNECT_ATTEMPTS=
WHATSAPP_RECONNECT_BASE_DELAY_MS=
WAHA_BASE_URL=http://127.0.0.1:3002
WAHA_API_KEY=
# Ceiling for one WAHA call. The budget for a whole command is announced by the
# API and shared across every WAHA call the command makes, so raising this alone
# does not let a command run longer. See docs/worker-command-budget.md.
WAHA_TIMEOUT_MS=10000
# Budget the API gives one worker command. History sync uses it, so lowering it
# reduces how deep a single page can read. Maximum 30000.
WORKER_TRANSPORT_TIMEOUT_MS=30000
# Required for private attachment storage when DATABASE_PROVIDER=supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# HMAC key for the opt-out identifier hash, which keeps an opt-out honoured after the
# contact that made it is deleted. Server-side secret: never commit it, never store it in
# the database and never log it. At least 32 characters.
# Required once the opt_out_history.identifier_hash column exists; until then it is unused.
# Rotating it invalidates every hash already stored — see docs/contatos-bloqueio-exclusao.md.
OPT_OUT_HASH_PEPPER=
# Call Service (Go) — provider paralelo de chamadas de voz. A WAHA continua
# dona das mensagens; as chamadas passam por este serviço.
CALL_SERVICE_URL=http://127.0.0.1:8080
# Número(s) próprio(s) de WhatsApp pareados no Call Service, usados para
# escolher a sessão de chamadas quando há mais de uma pareada.
WHATSAPP_OWN_NUMBERS=
