# Dashboard: estático. VITE_API_URL é variável de BUILD, não de runtime — muda a
# URL, muda o bundle. Por isso ela entra como build-arg, e não no compose.
FROM node:22-bookworm-slim AS build
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL
WORKDIR /repo
COPY package.json package-lock.json ./
COPY packages/contracts/package.json packages/contracts/
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
COPY apps/dashboard/package.json apps/dashboard/
RUN npm ci
COPY . .
RUN npm run build -w @chatpro/contracts && npm run build -w @chatpro/dashboard

FROM nginx:1.27-alpine AS runtime
COPY --from=build /repo/apps/dashboard/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
