# Copie para deploy/.env.prod, preencha, e deixe com permissão 600.
# deploy/.env.prod está no .gitignore e não deve ser versionado.

DATABASE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

WAHA_API_KEY=
WAHA_WEBHOOK_HMAC_KEY=
WAHA_WEBHOOK_WORKSPACE_ID=default-workspace
MEDIA_PROXY_TOKEN_SECRET=

WHATSAPP_PROVIDER=waha
WHATSAPP_CONNECTION_ENABLED=true
WHATSAPP_DEMO_MODE=false
WHATSAPP_OWN_NUMBERS=

# Origem do dashboard. Com o nginx encaminhando /api, a origem é a do próprio
# dashboard; separe por vírgula se houver mais de uma.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080

# Onde o dashboard escuta no host. Mantenha 127.0.0.1 até haver autenticação.
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8080

# Vazio = mesma origem (nginx encaminha). Só preencha se o front for servido
# de outro domínio — e lembre que é variável de BUILD.
VITE_API_URL=

# Padrão da WAHA é 180. Ver docs/waha-descartes-grupo-investigacao.md.
WHATSAPP_FILES_LIFETIME=3600
