# Worker: conexão WhatsApp de vida longa e transporte HTTP interno na 3101.
# Escreve em CHATPRO_DATA_DIR — `waha-sessions.json`, a única fonte dos aliases,
# e as credenciais do provider. Esse caminho exige volume nomeado.
#
# Roda por `tsx`, e não por `node dist/`, porque este repositório é source-first:
# `@chatpro/contracts` declara `"exports": "./src/index.ts"`, um arquivo
# TypeScript que o `node` não executa. Compilar sem mudar esse contrato produz
# um `dist` que não resolve o pacote — foi o que o primeiro build desta imagem
# fez. Trocar o contrato afeta o desenvolvimento inteiro e não cabe num
# Dockerfile; a saída correta, quando alguém quiser, é fazer os contracts
# emitirem JS e apontar `exports` para ele.
#
# Custo aceito: transpilação no arranque e devDependencies na imagem.
FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /repo
COPY package.json package-lock.json ./
COPY packages/contracts/package.json packages/contracts/
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
COPY apps/dashboard/package.json apps/dashboard/
# `--include=dev` é obrigatório: `tsx` é devDependency e é o interpretador.
RUN npm ci --include=dev
COPY packages ./packages
COPY apps/worker ./apps/worker
# Sem typecheck aqui de propósito: `tsconfig` inclui `test/**`, e os testes da
# API importam do worker. Exigi-lo obrigaria cada imagem a carregar o código da
# outra. O portão é do CI e do `npm run typecheck` local, onde o repositório
# inteiro está presente.
RUN mkdir -p /data && chown node:node /data
WORKDIR /repo/apps/worker
USER node
EXPOSE 3101
CMD ["npx", "tsx", "src/main.ts"]
