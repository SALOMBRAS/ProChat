# Worker: conexão WhatsApp de vida longa e transporte HTTP interno na 3101.
# Escreve estado em CHATPRO_DATA_DIR — waha-sessions.json (a única fonte dos
# aliases) e as credenciais do provider. Esse caminho precisa de volume nomeado.
FROM node:22-bookworm-slim AS build
WORKDIR /repo
COPY package.json package-lock.json ./
COPY packages/contracts/package.json packages/contracts/
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
COPY apps/dashboard/package.json apps/dashboard/
RUN npm ci
COPY . .
RUN npm run build -w @chatpro/contracts && npm run build -w @chatpro/worker

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /repo
COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/package.json ./package.json
COPY --from=build /repo/packages ./packages
COPY --from=build /repo/apps/worker ./apps/worker
RUN mkdir -p /data && chown node:node /data
WORKDIR /repo/apps/worker
USER node
EXPOSE 3101
CMD ["node", "dist/main.js"]
